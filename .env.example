# Comma-separated provider aliases exposed by the service.
CROSS_TALKER_PROVIDERS=openai,anthropic
CROSS_TALKER_DEFAULT_ROUNDS=1
CROSS_TALKER_MAX_ROUNDS=5
CROSS_TALKER_REQUEST_TIMEOUT_SECONDS=60
CROSS_TALKER_DATABASE_PATH=data/cross_talker.db

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
